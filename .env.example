# Copy to .env for local development:  cp .env.example .env
#
# Local dev uses the docker-compose Postgres (host port 5434). In production,
# DATABASE_URL is injected into the Azure Container App as a secret and is NOT
# stored here.
DATABASE_URL="postgresql://uniseek:uniseek@localhost:5434/uniseek?schema=public"

# Optional. Enables AI classification of extracurricular activities into EC tiers
# (lib/scoring/classifyActivities.ts). Without any key, activities fall back to a
# neutral tier and don't differentiate.
#
# Provider precedence: HF_API_KEY (Hugging Face) is used if set, else ANTHROPIC_API_KEY.
# Hugging Face is handy for cheap/free local testing (OpenAI-compatible router).
#   ANTHROPIC_API_KEY="sk-ant-..."        # override model: UNISEEK_CLASSIFIER_MODEL
#   HF_API_KEY="hf_..."                   # override model: UNISEEK_HF_MODEL
#                                         # (default meta-llama/Llama-3.1-8B-Instruct)

# Placeholder mode is ON BY DEFAULT: the results list AND the College Explorer render
# without spending any Claude API calls (/api/score classifier + /api/explore insight).
# Set to "false" to turn on real AI. NEXT_PUBLIC_* is inlined at build time, so a rebuild
# (or dev-server restart) is required after changing this.
# NEXT_PUBLIC_USE_PLACEHOLDER_RESULTS="false"

# The Explorer generates personalized per-college insight on demand (/api/explore),
# only when a student confirms. Uses ANTHROPIC_API_KEY; override the model here.
# UNISEEK_INSIGHT_MODEL="claude-opus-5"   # e.g. claude-haiku-4-5 for cheaper testing
