# Copy to .env for local development:  cp .env.example .env
#
# Local dev uses the docker-compose Postgres (host port 5434). In production,
# DATABASE_URL is injected into the Azure Container App as a secret and is NOT
# stored here.
DATABASE_URL="postgresql://uniseek:uniseek@localhost:5434/uniseek?schema=public"

# Optional. Enables AI classification of extracurricular activities into EC tiers
# (lib/scoring/classifyActivities.ts). Without it, activities fall back to a neutral
# tier and don't differentiate. Override the model with UNISEEK_CLASSIFIER_MODEL.
# ANTHROPIC_API_KEY="sk-ant-..."
